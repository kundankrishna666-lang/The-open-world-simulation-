    wait.className = 'text-[11px] text-amber-400/70'; wait.textContent = '🧘 बाबा जी विचार कर रहे हैं...';
    chat.appendChild(wait);
    setTimeout(() => { wait.remove(); const r = Baba.ask(q); bubble(r.text, 'baba', r.src); }, 600);
