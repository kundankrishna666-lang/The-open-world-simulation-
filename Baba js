  const chat = sec.querySelector('#baba-chat'), input = sec.querySelector('#baba-input');
  function bubble(text, who, src) {
    const d = document.createElement('div');
    d.className = who === 'me' ? 'text-xs bg-slate-800 text-slate-200 rounded-lg px-3 py-2 ml-8'
