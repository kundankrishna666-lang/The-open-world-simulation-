const Baba = {
  ask(q) {
    const t = q.toLowerCase();
    let best = null, score = 0;
    for (const e of BabaKnowledge) {
      const s = e.k.reduce((n, w) => n + (t.includes(w.toLowerCase()) ? 1 : 0), 0);
      if (s > score) { score = s; best = e; }
    }
    const p = Engine.player;
    const state = p.karma <= -15 ? 'तुम्हारा कर्म-स्कोर नीचे है। अब सेवा, शोध और ध्यान से दिशा बदलो।'
      : p.energy <= 20 ? 'तुम्हारी ऊर्जा कम है। पहले विश्राम और ध्यान करो।'
      : p.karma >= 25 ? 'तुम्हारा कर्म-पथ अच्छा है। इसे विनम्रता से जारी रखो।'
      : 'तुम्हारा पथ अभी खुला है। अगला निर्णय सोच-समझकर लो।';
    if (!best) return { text: 'पुत्र, इस प्रश्न का सीधा उत्तर मेरे पास नहीं है। कर्म, धर्म, ध्यान, क्रोध, धन, मृत्यु, राम, कृष्ण या सृष्टि जैसे विषय पर पूछो, तो मैं शास्त्रों का सार बता सकता हूँ। 🙏', src: '' };
    return { text: best.a + '\n\n🔮 ' + state, src: best.src };
  }
};

